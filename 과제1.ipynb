   "source": [
    "a = float(input(\"x^2의 계수를 입력해주세요: \")) \n",
    "b = float(input(\"x의 계수를 입력해주세요: \")) \n",
    "c = float(input(\"상수의 계수를 입력해주세요: \")) \n",
    "\n",
    "root1 = (-b + (b**2-4*a*c)**0.5)/(2*a)\n",
    "root2 =(-b - (b**2-4*a*c)**0.5)/(2*a)\n",
    "\n",
    "print(root1, root2)"
   ]
  }
 ],
